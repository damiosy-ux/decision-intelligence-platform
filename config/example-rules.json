{
  "version": "0.1.0",
  "source_filter": {
    "accept_routes": [
      "League.aspx",
      "SubLeague.aspx"
    ],
    "reject_keywords": [
      "cup",
      "friendly",
      "shield",
      "super cup",
      "playoff",
      "play-off",
      "promotion",
      "relegation",
      "qualification",
      "knockout",
      "exhibition"
    ]
  },
  "metrics": {
    "short_window": "L3",
    "long_window": "L10",
    "positive_signal": {
      "selected_gf_min": 2.0,
      "opponent_gf_max": 1.3
    },
    "suppression_signal": {
      "selected_ga_max": 1.3,
      "opponent_ga_min": 2.0
    }
  },
  "classification": {
    "2": "high_confidence",
    "1": "lean",
    "0": "skip"
  },
  "tie_breaking": {
    "minimum_alignment_gap": 1.0,
    "otherwise": "skip"
  }
}
